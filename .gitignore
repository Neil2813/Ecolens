# Dependencies
**/node_modules/
**/.venv/
**/venv/
**/env/
**/ENV/

# Production & Build outputs
**/dist/
**/dist-ssr/
**/.output/
**/.vinxi/
**/.tanstack/
**/.nitro/

# Python compiled / cache
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.pyc
**/*.pyo
**/*.pyd

# Testing & Coverage
**/.pytest_cache/
**/.coverage
**/htmlcov/

# AWS SAM & Local Cloud Emulation
**/.aws-sam/
**/.localstack/

# Environment configurations (allow .env.example)
**/.env
**/.env.local
**/.env.*.local
**/.env.dev
**/.env.prod
**/.env.test
!**/.env.example

# Databases
**/*.db
**/*.sqlite3
**/fallback.db

# Generated audio tours and temporary scratch scripts
**/generated_audio/*.mp3
**/scratch/

# AI Assistant logs and debug dumps
**/assistant_log.txt
**/assistant_debug.json

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
